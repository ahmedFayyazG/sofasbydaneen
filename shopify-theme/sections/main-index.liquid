<div id="top">
  <div class="announce"><span aria-hidden="true">‹</span><p>International delivery.</p><span aria-hidden="true">›</span></div>

  <header class="site-header">
    <button class="mobile-menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-navigation">MENU</button>
    <a class="brand" href="#top" aria-label="Sofas By Daneen home"><span>Sofas By Daneen</span></a>
    <nav id="primary-navigation" class="main-nav" aria-label="Primary navigation">
      <a href="#collection">Our Creations <small aria-hidden="true">⌄</small></a>
      <a href="#sur-mesure">Bespoke by Sofas By Daneen</a>
      <a href="#professionals">Professionals</a>
      <a href="#showrooms">Showrooms</a>
      <a href="#atelier">Craftsmanship</a>
    </nav>
    <div class="header-tools" aria-label="Customer tools">
      <a href="{{ routes.search_url }}" aria-label="Search"><span class="head-icon" aria-hidden="true">⌕</span></a>
      <a href="/pages/wishlist" aria-label="Wishlist"><span class="head-icon" aria-hidden="true">♡</span></a>
      <a href="{{ routes.account_url }}" aria-label="Account"><span class="head-icon" aria-hidden="true">♙</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Basket" class="bag-icon">▢<b aria-hidden="true">{{ cart.item_count }}</b></a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero-clone" aria-label="Sofas By Daneen summer sale">
      <img class="hero-desktop-image" src="{{ 'sofas-by-daneen-hero.png' | asset_url }}" alt="Sofas By Daneen summer sale living room" width="1584" height="672" loading="eager">
      <img class="hero-mobile-image" src="{{ 'sofas-by-daneen-mobile-hero.png' | asset_url }}" alt="Sofas By Daneen summer sale living room" width="928" height="1152" loading="eager">
    </section>

    <section class="bespoke-heading" id="sur-mesure" aria-labelledby="bespoke-title">
      <p class="kicker">COUTURE FURNITURE HOUSE</p>
      <h2 id="bespoke-title">YOUR INTERIOR DESERVES A<br>BESPOKE PIECE</h2>
      <p class="soft-copy"><em>Choose your model, choose your fabric.<br>We craft the rest by hand in our workshops in France.</em></p>
      <i class="tiny-rule" aria-hidden="true"></i>
    </section>

    <section class="process-grid" aria-label="How bespoke furniture is made">
      <article>
        <div class="process-image-space"><img class="model-step-image" src="{{ 'choose-model-sofa.png' | asset_url }}" alt="" width="1536" height="1024" loading="lazy"></div>
        <h3>1 · I CHOOSE MY MODEL</h3>
        <p>Armchair, bench or ottoman—each silhouette is designed to bring character to your space.</p>
      </article>
      <article>
        <div class="process-image-space"><img class="fabric-step-image" src="{{ 'choose-fabric-sofa.png' | asset_url }}" alt="" width="1536" height="1024" loading="lazy"></div>
        <h3>2 · I CHOOSE MY FABRIC</h3>
        <p>Our couture collection or the designer of your choice: Lelièvre, Pierre Frey… Complimentary sample.</p>
      </article>
      <article>
        <div class="process-image-space"><img class="delivery-step-image" src="{{ 'delivery-worldwide-truck.png' | asset_url }}" alt="" width="1536" height="1024" loading="lazy"></div>
        <h3>3 · DELIVERED WITH CARE WORLDWIDE</h3>
        <p>Handcrafted in France and delivered with all the care your piece deserves. International delivery.</p>
      </article>
    </section>

    <section class="appointment-clone" aria-label="Bespoke consultation">
      <p><em>15 minutes to imagine your piece together</em></p>
      <div><a class="pill filled" href="#showrooms">BOOK AN APPOINTMENT →</a><a class="pill" href="#showrooms">COMPLIMENTARY SAMPLE →</a></div>
      <div class="promises"><span>• &nbsp; MADE IN FRANCE</span><span>• &nbsp; ARTISANAL BESPOKE</span><span>• &nbsp; INTERNATIONAL DELIVERY</span></div>
    </section>

    <section class="collection-heading deferred-section" id="collection" aria-labelledby="collection-title">
      <i aria-hidden="true"></i><h2 id="collection-title">OUR COLLECTIONS</h2>
      <p>Handcrafted by our French carpenters and upholsterers.<br><strong>Each piece begins with a pencil sketch.</strong><br>We unite <strong>design</strong> and <strong>couture</strong> to create collections that are<br><strong>distinctive</strong>, elegant and free—like poetry.</p>
    </section>

    <section class="products-clone deferred-section" aria-label="Featured furniture">
      <article>
        <a href="#collection" class="product-image" aria-label="View The Colette - Bespoke Armchair"><img src="https://www.clovi-paris.com/cdn/shop/files/Design_sans_titre_-_2026-06-09T223919.772.png?v=1781037584&width=750" alt="The Colette - Bespoke Armchair" width="750" height="750" loading="lazy"></a>
        <div class="swatch-row" aria-label="1 available colour"><span style="background:#b55273" aria-hidden="true"></span></div>
        <h3>The Colette - Bespoke Armchair</h3><p>€2.590,00</p>
      </article>
      <article>
        <a href="#collection" class="product-image" aria-label="View The Claudel - Designer Ottoman"><img src="https://www.clovi-paris.com/cdn/shop/files/CLAUDEL_VELOURSMILLERAIESNUAGE_f5af7109-ad68-4f70-ad2d-4496385a0ec5.jpg?v=1769592818&width=750" alt="The Claudel - Designer Ottoman" width="750" height="750" loading="lazy"></a>
        <div class="swatch-row" aria-label="7 available colours"><span style="background:#d9e2df" aria-hidden="true"></span><span style="background:#e9dfd1" aria-hidden="true"></span><span style="background:#a87955" aria-hidden="true"></span><span style="background:#caa179" aria-hidden="true"></span><span style="background:#7b3b34" aria-hidden="true"></span><span style="background:#9b5e3d" aria-hidden="true"></span><span style="background:#efe5cf" aria-hidden="true"></span></div>
        <h3>The Claudel - Designer Ottoman</h3><p>€790,00</p>
      </article>
      <article>
        <a href="#collection" class="product-image" aria-label="View The Gainsbourg - Nobilis Fawn"><img src="https://www.clovi-paris.com/cdn/shop/files/Design_sans_titre_45.jpg?v=1776282343&width=750" alt="The Gainsbourg - Nobilis Fawn" width="750" height="750" loading="lazy"></a>
        <div class="swatch-row" aria-label="1 available colour"><span style="background:#a8784f" aria-hidden="true"></span></div>
        <h3>The Gainsbourg - Nobilis Fawn</h3><p>€2.580,00</p>
      </article>
      <article>
        <a href="#collection" class="product-image" aria-label="View The Pompidou - Vegan Leather"><img src="https://www.clovi-paris.com/cdn/shop/files/Cuir_graine_modele_8.png?v=1781259329&width=750" alt="The Pompidou - Vegan Leather" width="750" height="750" loading="lazy"></a>
        <div class="swatch-row" aria-label="1 available colour"><span style="background:#2c2928" aria-hidden="true"></span></div>
        <h3>The Pompidou - Vegan Leather</h3><p>€1.780,00</p>
      </article>
    </section>
    <div class="pagination" aria-hidden="true"><b></b><span></span></div>

    <section class="couture-video deferred-section" aria-label="The soul of Sofas By Daneen">
      <video muted loop playsinline preload="none" poster="https://www.clovi-paris.com/cdn/shop/files/preview_images/0eccb956855e4d8980e92c8b40dbb930.thumbnail.0000000000_1080x.jpg?v=1774014735" aria-label="Sofas By Daneen couture furniture film" data-src="https://www.clovi-paris.com/cdn/shop/videos/c/vp/25be61db40a84accb971898ec2e650de/25be61db40a84accb971898ec2e650de.HD-1080p-7.2Mbps-44808719.mp4?v=0"></video>
      <a href="#collection" class="video-button">DISCOVER THE SOUL OF SOFAS BY DANEEN &nbsp; →</a>
    </section>

    <section class="couture-copy deferred-section" aria-labelledby="couture-title">
      <h2 id="couture-title">DESIGN MEETS COUTURE</h2>
      <p>The art of upholstery lies in a delicate balance<br>between artisanal excellence and the poetry of gesture.<br><strong>Velvets, jacquards and natural linens…<br>fabrics that bring an extra soul to your interior.</strong><br>Sourced from the finest mills with artisanal expertise,<br>our fabrics celebrate material and texture.</p>
      <p>A deep desire to bring <strong>beautiful fabrics of the past</strong> back into the light<br>and warm interiors with a soul that is both <strong>poetic and sensual.</strong></p>
      <a class="pill" href="#showrooms">COMPLIMENTARY SAMPLES</a>
    </section>

    <section class="atelier-clone deferred-section" id="atelier" aria-labelledby="atelier-title">
      <div class="atelier-photo"><video muted loop playsinline preload="none" aria-label="Upholsterer working in the Sofas By Daneen workshop" data-src="https://cdn.shopify.com/videos/c/o/v/3bfbf39d29994058b6e380aed8530e61.mov"></video></div>
      <div class="atelier-content">
        <span class="atelier-tag">LILLE WORKSHOP · CONTEMPORARY ARTISAN</span>
        <h2 id="atelier-title">HANDMADE<br>IN LILLE</h2><i aria-hidden="true"></i>
        <p>Every Sofas By Daneen piece is born in our northern French workshop. Our upholsterers craft each one by hand, with the same care for a unique commission as for a professional series.</p>
        <div class="atelier-points"><div><b aria-hidden="true">✂</b><p><strong>ARTISANAL BESPOKE</strong><span>Every dimension, fabric and finish is tailored to your space and your wishes.</span></p></div><div><b aria-hidden="true">🏅</b><p><strong>QUALITY &amp; DURABILITY</strong><span>Materials selected to last. Certified fabrics, robust structures and refined finishes.</span></p></div><div><b aria-hidden="true">📍</b><p><strong>LOCAL CRAFT &amp; GUARANTEE</strong><span>Made in France and guaranteed by our artisans. One contact from design to delivery.</span></p></div></div>
        <a class="pill" href="#atelier">DISCOVER OUR WORKSHOP →</a>
      </div>
    </section>

    <section class="featured-product deferred-section" aria-label="Featured Pompidou bench">
      <div class="featured-room"><img src="https://www.clovi-paris.com/cdn/shop/files/Design_sans_titre_36.jpg?v=1762263387&width=1080" alt="Bespoke Sofas By Daneen bench in a contemporary room" width="1080" height="1350" loading="lazy"></div>
      <a class="featured-card" href="#collection">
        <img src="https://www.clovi-paris.com/cdn/shop/files/POMPIDOU_VELOURSCHENILLECOGNAC_89f7c88a-8a16-4ab9-a378-4d7d7385c999.jpg?v=1769592861&width=750" alt="The Pompidou in cognac striped chenille" width="750" height="750" loading="lazy">
        <small>Cognac striped chenille</small>
        <h3>The Pompidou - Designer Bench - Cognac Striped Chenille</h3>
        <p>€1.480,00</p>
      </a>
    </section>

    <section class="reviews-clone deferred-section" aria-labelledby="reviews-title">
      <h2 id="reviews-title">Let our clients speak for us</h2>
      <div class="review-score"><span role="img" aria-label="5 out of 5 stars">★★★★★</span><small>from 12 reviews &nbsp; ✅</small></div>
      <div class="review-grid">
        <article><b role="img" aria-label="5 out of 5 stars">★★★★★</b><h3>I love it</h3><p>A superb, beautiful bench!<br>Excellent quality!<br>It transforms my entrance.</p><small>Anne Castel</small></article>
        <article><b role="img" aria-label="5 out of 5 stars">★★★★★</b><h3>Magnificent!</h3><p>The seat is beautiful and fits my interior perfectly. The fabric is genuinely exceptional quality 😍</p><small>Sarah</small></article>
        <article><b role="img" aria-label="5 out of 5 stars">★★★★★</b><h3>Original and so beautiful</h3><p>The fabric is simply gorgeous!<br>The autumnal colours work perfectly with the furniture.</p><small>Amandine Roquette</small></article>
      </div>
    </section>

  </main>

  <div class="prefooter-mark deferred-section"><span aria-label="Sofas By Daneen monogram">SBD</span></div>

  <footer id="showrooms" class="deferred-section">
    <a class="footer-logo" href="#top" aria-label="Sofas By Daneen home">Sofas By Daneen</a>
    <div class="footer-news">
      <h2>Join our newsletter and receive a €15 gift voucher</h2>
      <p>Your weekly dose of inspiration.<br>Discover our creations first and receive a €15 voucher for your next order over €150.</p>

        <label class="sr-only" for="newsletter-email">Email address</label>
        <input id="newsletter-email" name="contact[email]" type="email" autocomplete="email" inputmode="email" placeholder="Your email *">
        <button type="submit" aria-label="Subscribe to the newsletter">→</button>
      {% endform %}
    </div>
    <div class="footer-columns"><div><h4>The House of Sofas By Daneen</h4><a href="#sur-mesure">The House</a><a href="#collection">Lookbook</a><a href="#collection">Fabrics</a><a href="#showrooms">Showrooms</a><a href="#atelier">The Sofas By Daneen Workshop</a><a href="#atelier">Reupholstery - Artisan Upholsterers</a></div><div><h4>Information &amp; Contact</h4><a href="{{ routes.search_url }}">Search</a><a href="#showrooms">Find a showroom</a><a href="#showrooms">Catalogue</a><a href="#collection">Leopard Ottoman</a><a href="#collection">Designer Benches</a><a href="#collection">Editorials</a></div><div id="professionals"><h4>Legal Information</h4><a href="/policies/legal-notice">Legal notice</a><a href="{{ shop.privacy_policy.url | default: '#' }}">Privacy policy</a><a href="{{ shop.terms_of_service.url | default: '#' }}">Terms and conditions</a><a href="#showrooms">FAQ</a><a href="#showrooms">Make a return</a><a href="#showrooms">Contact us</a></div><div><h4>Follow Us</h4><a href="#showrooms">YouTube</a><a href="#showrooms">Pinterest</a><a href="#showrooms">Instagram</a><a href="#showrooms">LinkedIn</a><a href="#showrooms">Email</a></div></div>

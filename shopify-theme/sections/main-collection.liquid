<main class="shopify-basic-page">
  <section class="collection-heading">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div class="soft-copy">{{ collection.description }}</div>{% endif %}
  </section>
  <section class="products-clone">
    {% for product in collection.products %}
      <article>
        <a class="product-image" href="{{ product.url }}"><img src="{{ product.featured_image | image_url: width: 750 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="750" height="750" loading="lazy"></a>
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
      </article>
    {% else %}
      <p>No products found.</p>
    {% endfor %}
  </section>
</main>

{% schema %}
{"name":"Collection","settings":[]}
{% endschema %}
